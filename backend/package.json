    "mern",
    "hospital-management-system",
    "appointment-booking",
    "healthcare",
    "medical",
    "ai",
    "voice-assistant",
    "nodejs",
    "express",
    "mongodb",
    "typescript"
  ],
  "author": "MD Rohanul Haque Rohan",
